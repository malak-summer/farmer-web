# Public build-time setting. Use the client's Turnstile widget site key.
VITE_TURNSTILE_SITE_KEY=

# Server-only values: configure in Netlify Functions environment, never VITE_*.
SITE_ORIGIN=
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=
CONTACT_RECEIPT_SECRET=
TURNSTILE_SECRET_KEY=

# Optional approved public HTTPS origin for canonical/OG/sitemap generation.
# Leave empty until the real domain is confirmed. Does not remove noindex.
PUBLIC_SITE_URL=
